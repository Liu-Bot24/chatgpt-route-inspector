{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-inspector.local/schemas/route-turn.v1.schema.json",
  "title": "ChatGptRouteObservationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "captureId", "sources", "captureMode", "phase", "requestedModel",
    "responseModelSlug", "defaultModelSlug", "resolvedModelSlug", "serverModelSlug", "domModelSlug",
    "thinkingEffort", "planType", "requestId", "conversationId", "conversationMode",
    "selectedSourcesCount", "toolInvoked", "toolName", "isSearch", "hadImage", "fastConvo",
    "verdict", "routeModel", "routeModelSources", "modelLabel", "modelLabelSources", "modelLabelConflict", "reasons",
    "tabId", "pageUrl", "networkRequestId", "observedAt", "startedAt", "completedAt",
    "durationMs", "errorCode", "deepResearchRemaining", "deepResearchResetAt", "imageGenRemaining", "imageGenResetAt", "quotaObservedAt"
  ],
  "properties": {
    "schema": { "const": "chatgpt-route-observation" },
    "schemaVersion": { "const": "1.6.0" },
    "deepResearchRemaining": { "type": ["integer", "null"], "minimum": 0 },
    "deepResearchResetAt": { "type": ["string", "null"], "format": "date-time" },
    "imageGenRemaining": { "type": ["integer", "null"], "minimum": 0 },
    "imageGenResetAt": { "type": ["string", "null"], "format": "date-time" },
    "quotaObservedAt": { "type": ["string", "null"], "format": "date-time" },
    "captureId": { "type": "string" },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["page_fetch", "page_websocket", "conversation_record", "assistant_dom"] } },
    "captureMode": { "enum": ["live", "reload"] },
    "phase": { "enum": ["requested", "responding", "completed", "failed"] },
    "requestedModel": { "type": ["string", "null"] },
    "responseModelSlug": { "type": ["string", "null"] },
    "defaultModelSlug": { "type": ["string", "null"] },
    "resolvedModelSlug": { "type": ["string", "null"] },
    "serverModelSlug": { "type": ["string", "null"] },
    "domModelSlug": { "type": ["string", "null"] },
    "thinkingEffort": { "type": ["string", "null"] },
    "planType": { "type": ["string", "null"] },
    "requestId": { "type": ["string", "null"] },
    "conversationId": { "type": ["string", "null"] },
    "conversationMode": { "type": ["string", "null"] },
    "selectedSourcesCount": { "type": ["integer", "null"], "minimum": 0 },
    "toolInvoked": { "type": ["boolean", "null"] },
    "toolName": { "type": ["string", "null"] },
    "isSearch": { "type": ["boolean", "null"] },
    "hadImage": { "type": ["boolean", "null"] },
    "fastConvo": { "type": ["boolean", "null"] },
    "verdict": { "enum": ["normal", "mismatch", "conflict", "unknown", "auto_reasoning"] },
    "routeModel": { "type": ["string", "null"] },
    "routeModelSources": { "type": "array", "uniqueItems": true, "items": { "enum": ["resolved_model_slug", "server_ste_metadata.model_slug", "assistant.metadata.model_slug", "assistant[data-message-model-slug]"] } },
    "modelLabel": { "type": ["string", "null"] },
    "modelLabelSources": { "type": "array", "uniqueItems": true, "items": { "enum": ["assistant.metadata.model_slug", "assistant[data-message-model-slug]"] } },
    "modelLabelConflict": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "tabId": { "type": ["integer", "null"] },
    "pageUrl": { "type": ["string", "null"] },
    "networkRequestId": { "type": ["string", "null"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "durationMs": { "type": ["number", "null"], "minimum": 0 },
    "errorCode": { "type": ["string", "null"] }
  }
}
